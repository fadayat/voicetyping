#!/bin/sh
set -eu

APPDIR=${APPDIR:?APPDIR is required}
PYTHON="$APPDIR/usr/bin/python3"
APPLICATION="$APPDIR/usr/src/voicetyping/voicetyping.py"

if [ "$#" -eq 1 ] && [ "$1" = "--toggle" ]; then
    user_id=$(id -u)
    if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        RUNTIME_DIR=$XDG_RUNTIME_DIR
    elif [ -d "/run/user/$user_id" ]; then
        RUNTIME_DIR="/run/user/$user_id"
    else
        RUNTIME_DIR=${TMPDIR:-${TEMP:-${TMP:-/tmp}}}
    fi
    PID_FILE="$RUNTIME_DIR/voicetyping-$user_id.pid"

    [ -r "$PID_FILE" ] || exit 1
    pid=
    IFS= read -r pid <"$PID_FILE" || [ -n "$pid" ] || exit 1
    if [ -z "$pid" ]; then
        exit 1
    fi
    case "$pid" in
        ''|*[!0-9]*) exit 1 ;;
    esac
    case "$pid" in
        *[1-9]*) ;;
        *) exit 1 ;;
    esac

    proc_cmdline="/proc/$pid/cmdline"
    if [ ! -r "$proc_cmdline" ]; then
        exit 1
    fi
    arguments=$(tr '\000' '\n' <"$proc_cmdline" 2>/dev/null) || exit 1
    if ! printf '%s\n' "$arguments" | grep -Eq '(^|/)voicetyping\.py$'; then
        exit 1
    fi

    current_pid=
    IFS= read -r current_pid <"$PID_FILE" || [ -n "$current_pid" ] || exit 1
    if [ "$current_pid" != "$pid" ]; then
        exit 1
    fi
    kill -USR1 "$pid"
    exit $?
fi

exec "$PYTHON" "$APPLICATION" "$@"
