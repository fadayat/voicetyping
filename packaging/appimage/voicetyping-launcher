#!/bin/sh
set -eu

APPDIR=${APPDIR:?APPDIR is required}
PYTHON="$APPDIR/usr/bin/python3"

if [ "$#" -eq 1 ] && [ "$1" = "--toggle" ]; then
    [ -n "${APPIMAGE:-}" ] || exit 1
    user_id=$(id -u)
    if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        RUNTIME_DIR=$XDG_RUNTIME_DIR
    elif [ -d "/run/user/$user_id" ]; then
        RUNTIME_DIR="/run/user/$user_id"
    else
        RUNTIME_DIR=${TMPDIR:-${TEMP:-${TMP:-/tmp}}}
    fi
    PID_FILE="$RUNTIME_DIR/voicetyping-$user_id.pid"

    [ -r "$PID_FILE" ] || exit 1
    pid=
    IFS= read -r pid <"$PID_FILE" || [ -n "$pid" ] || exit 1
    if [ -z "$pid" ]; then
        exit 1
    fi
    case "$pid" in
        ''|*[!0-9]*) exit 1 ;;
    esac
    case "$pid" in
        *[1-9]*) ;;
        *) exit 1 ;;
    esac

    proc_cmdline="/proc/$pid/cmdline"
    proc_environment="/proc/$pid/environ"
    if [ ! -r "$proc_cmdline" ] || [ ! -r "$proc_environment" ]; then
        exit 1
    fi
    arguments=$(tr '\000' '\n' <"$proc_cmdline" 2>/dev/null) || exit 1
    environment=$(tr '\000' '\n' <"$proc_environment" 2>/dev/null) || exit 1
    first_argument=$(printf '%s\n' "$arguments" | sed -n '1p')
    second_argument=$(printf '%s\n' "$arguments" | sed -n '2p')
    third_argument=$(printf '%s\n' "$arguments" | sed -n '3p')
    running_appdir=$(printf '%s\n' "$environment" | sed -n 's/^APPDIR=//p' | sed -n '1p')
    running_appimage=$(printf '%s\n' "$environment" | sed -n 's/^APPIMAGE=//p' | sed -n '1p')
    if [ -z "$running_appdir" ] || \
        [ "$running_appimage" != "$APPIMAGE" ] || \
        [ "$first_argument" != "$running_appdir/usr/bin/python3" ] || \
        [ "$second_argument" != "-m" ] || \
        [ "$third_argument" != "voicetyping.app" ]; then
        exit 1
    fi

    current_pid=
    IFS= read -r current_pid <"$PID_FILE" || [ -n "$current_pid" ] || exit 1
    if [ "$current_pid" != "$pid" ]; then
        exit 1
    fi
    kill -USR1 "$pid"
    exit $?
fi

exec "$PYTHON" -m voicetyping.app "$@"
