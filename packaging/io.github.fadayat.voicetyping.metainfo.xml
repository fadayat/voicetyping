<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.fadayat.voicetyping</id>
  <name>VoiceTyping</name>
  <summary>Press F8 to dictate into the focused field</summary>
  <developer id="io.github.fadayat">
    <name>fadayat</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      VoiceTyping records speech between two F8 presses, transcribes it with
      Gemini, and pastes the finalized text into the focused field.
    </p>
    <p>
      It supports terminal-aware paste, Live transcription with a complete
      recording fallback, and a click-through audio indicator.
    </p>
  </description>
  <launchable type="desktop-id">io.github.fadayat.voicetyping.desktop</launchable>
