#!/bin/sh
set -eu

export PYTHONNOUSERSITE=1
export PYTHONPATH=/opt/voicetyping/vendor
export VOICETYPING_LAUNCHER=/usr/bin/voicetyping

case "${0##*/}" in
    voicetyping-toggle)
        exec /usr/bin/python3 -m voicetyping.voicetyping_toggle "$@"
        ;;
esac

exec /usr/bin/python3 -m voicetyping.app "$@"
